{
  "name": "@prisma/adapter-pg",
  "version": "0.0.0",
  "description": "Fork of @prisma/adapter-pg — PostgreSQL driver adapter for Prisma ORM with PostGIS OID detection. Automatically converts geometry/geography columns to GeoJSON objects.",
  "keywords": [
    "Prisma",
    "adapter",
    "driver",
    "pg",
    "node-postgres",
    "PostgreSQL",
    "Postgres",
    "database",
    "PostGIS",
    "geometry",
    "geography",
    "GeoJSON",
    "spatial",
    "GIS",
    "fork",
    "vertexa"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/adapter-pg"
  },
  "scripts": {
    "dev": "DEV=true tsx helpers/build.ts",
    "build": "tsx helpers/build.ts",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Tom Houlé <houle@prisma.io>",
  "license": "Apache-2.0",
  "sideEffects": false,
  "dependencies": {
    "@prisma/driver-adapter-utils": "workspace:*",
    "pg": "^8.16.3",
    "postgres-array": "3.0.4",
    "@types/pg": "^8.16.0"
  },
  "devDependencies": {
    "@prisma/debug": "workspace:*"
  }
}
