{
  "name": "@prisma/config",
  "version": "0.0.0",
  "description": "Fork of @prisma/config — loader for prisma.config.ts configuration files. Internal package consumed by @vertexa/prisma CLI.",
  "keywords": [
    "Prisma",
    "config",
    "configuration",
    "prisma.config.ts",
    "internal",
    "fork",
    "vertexa"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/config"
  },
  "license": "Apache-2.0",
  "author": "Alberto Schiabel <schiabel@prisma.io>",
  "dependencies": {
    "c12": "3.3.4",
    "deepmerge-ts": "7.1.5",
    "effect": "3.20.0",
    "empathic": "2.0.0"
  },
  "devDependencies": {
    "@prisma/debug": "workspace:*",
    "@prisma/get-platform": "workspace:*",
    "dotenv": "17.2.3"
  },
  "scripts": {
    "dev": "DEV=true tsx helpers/build.ts",
    "build": "tsx helpers/build.ts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
